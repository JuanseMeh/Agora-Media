# Google Cloud
# Option A: Service account JSON key (traditional)
# GOOGLE_APPLICATION_CREDENTIALS=/app/credentials/gcp-service-account.json
# Option B: Application Default Credentials (via `gcloud auth application-default login`)
#   The docker-compose.yml mounts ~/.config/gcloud/application_default_credentials.json
#   and sets GOOGLE_APPLICATION_CREDENTIALS=/tmp/gcp-creds.json automatically.
GCS_BUCKET_NAME=agora-media-uploads
GCS_LOCATION=US

# Services (Docker internal DNS)
USERS_SERVICE_URL=http://user-service:8080
WORKSPACE_SERVICE_URL=http://workspace-service:8080

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://media:media@media-db:5432/media

# App
APP_PORT=8003
APP_ENV=development
LOG_LEVEL=INFO

# Signed URLs
SIGNED_URL_EXPIRY_SECONDS=3600

# Processing
MAX_FILE_SIZE_MB=100
OCR_LANGUAGE_HINTS=es,en
